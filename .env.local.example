# Cliniva OS — Environment Variables
# Copy this file to .env.local and fill in your Supabase project credentials

# ─── Supabase ───────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard/project/<your-project>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Stripe (Phase 2 — Monetization) ───────────────────────
# TODO: [STRIPE] Add when implementing subscription billing
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── FHIR Integration (Phase 3 — Interoperability) ─────────
# TODO: [FHIR] Add SMART on FHIR OAuth credentials when integrating external EHRs
# FHIR_SERVER_URL=https://your-fhir-server.com/fhir
# FHIR_CLIENT_ID=your-client-id
# FHIR_CLIENT_SECRET=your-client-secret

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
